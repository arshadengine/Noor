# Noor Configuration
# ─────────────────────────────────────────────
# Model used for quick conversational chat (Friend Mode)
NOOR_FAST_MODEL=llama3.2:latest

# Model used for deep reasoning/explanation (Mentor/Researcher Mode)
NOOR_HEAVY_MODEL=gemma4:latest

# Used for coding tasks / code review
NOOR_CODER_MODEL=qwen2.5-coder:latest

# Embedding model (will be pulled automatically if missing)
NOOR_EMBED_MODEL=nomic-embed-text:latest

# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# Paths
DB_PATH=data/noor.db
CHROMA_PATH=chroma_db
KNOWLEDGE_PATH=knowledge
PERSONALITY_PATH=configs/personality.txt

# API settings
API_HOST=127.0.0.1
API_PORT=8000

# UI settings
UI_HOST=127.0.0.1
UI_PORT=7860
UI_SHARE=false

# Memory settings
CONVERSATION_WINDOW=20
TOP_K_MEMORIES=5

# Gemini Integration Settings (Optional)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# OpenRouter Integration Settings (Optional)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Groq Integration Settings (Optional)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
